{
  "name": "siyuan-arco-calendar",
  "version": "2.4.0",
  "type": "module",
  "description": "A calendar panel plugin for SiYuan Note, rebuilt with React and shadcn/ui",
  "repository": "https://github.com/svchord/siyuan-arco-calendar",
  "homepage": "https://github.com/svchord/siyuan-arco-calendar",
  "author": "svchord",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm run type-check && vite build --watch",
    "build": "pnpm run type-check && vite build",
    "build-only": "vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "open": "siyuan-devtools open --frontend desktop",
    "shot": "siyuan-devtools shot",
    "type-check": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "siyuan": "^1.2.9",
    "siyuan-devtools": "^0.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-siyuan": "^0.1.0",
    "vitest": "^5.0.5"
  }
}
