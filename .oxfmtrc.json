{
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "/dev",
    "src/components/ui",
    "package.zip",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ]
}
